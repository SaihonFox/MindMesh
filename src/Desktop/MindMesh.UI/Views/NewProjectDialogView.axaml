<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:projects="using:MindMesh.Presentation.Projects"
			 xmlns:ctl="using:MindMesh.UI.Controls"
			 x:Class="MindMesh.UI.Views.NewProjectDialogView"
			 x:DataType="projects:NewProjectDialogViewModel">

	<!-- A dark, see-through layer over the whole window with the dialog in the middle. -->
	<Grid Background="#66101828">
		<Border Classes="floating"
				Width="440"
				Padding="24"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
			<StackPanel Spacing="14">
				<TextBlock Classes="h2" Text="{Binding Loc[Project_NewTitle]}" />

				<StackPanel Spacing="6">
					<TextBlock Classes="secondary" Text="{Binding Loc[ProjectKind_Title]}" />
					<ListBox Background="Transparent"
							 BorderThickness="0"
							 Padding="0"
							 ItemsSource="{Binding Kinds}"
							 SelectedItem="{Binding SelectedKind}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemContainerTheme>
							<ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
								<Setter Property="Margin" Value="0,0,6,6" />
								<Setter Property="Padding" Value="10,8" />
								<Setter Property="CornerRadius" Value="10" />
								<Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
							</ControlTheme>
						</ListBox.ItemContainerTheme>
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="projects:ProjectKindOption">
								<StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Hint}">
									<ctl:Icon Key="{Binding IconKey}" Width="16" Height="16" />
									<TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBlock Classes="secondary" Text="{Binding Loc[Project_Name]}" />
					<TextBox x:Name="NameBox"
							 MaxLength="120"
							 PlaceholderText="{Binding Loc[Project_NamePlaceholder]}"
							 Text="{Binding Name, Mode=TwoWay}"
							 AttachedToVisualTree="OnNameAttached">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
							<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
						</TextBox.KeyBindings>
					</TextBox>
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBlock Classes="secondary" Text="{Binding Loc[Project_Description]}" />
					<TextBox AcceptsReturn="True"
							 TextWrapping="Wrap"
							 MinHeight="84"
							 MaxLength="500"
							 PlaceholderText="{Binding Loc[Project_DescriptionPlaceholder]}"
							 Text="{Binding Description, Mode=TwoWay}" />
				</StackPanel>

				<TextBlock Foreground="{DynamicResource MM.Brush.Error}"
						   TextWrapping="Wrap"
						   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
						   Text="{Binding Error}" />

				<StackPanel Orientation="Horizontal"
							Spacing="8"
							HorizontalAlignment="Right">
					<Button Command="{Binding CancelCommand}" Content="{Binding Loc[Project_Cancel]}" />
					<Button Classes="primary"
							Command="{Binding CreateCommand}"
							Content="{Binding Loc[Project_Create]}" />
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>

</UserControl>
