<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:projects="using:MindMesh.Presentation.Projects"
			 xmlns:views="using:MindMesh.UI.Views"
			 x:Class="MindMesh.UI.Views.ProjectsPageView"
			 x:DataType="projects:ProjectsPageViewModel">

	<ScrollViewer>
		<StackPanel MaxWidth="820"
					Margin="40,40"
					Spacing="20"
					HorizontalAlignment="Stretch">

			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBlock Grid.Column="0"
						   Classes="h1"
						   VerticalAlignment="Center"
						   Text="{Binding Loc[Sidebar_Projects]}" />
				<Button Grid.Column="1"
						Margin="0,0,8,0"
						Command="{Binding OpenFileCommand}"
						Content="{Binding Loc[Project_OpenFile]}" />
				<Button Grid.Column="2"
						Classes="primary"
						Command="{Binding NewCommand}"
						Content="{Binding Loc[Project_New]}" />
			</Grid>

			<views:ProjectGalleryView />
		</StackPanel>
	</ScrollViewer>

</UserControl>
