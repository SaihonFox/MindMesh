<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:welcome="using:MindMesh.Presentation.Pages.Welcome"
			 xmlns:ctl="using:MindMesh.UI.Controls"
			 xmlns:views="using:MindMesh.UI.Views"
			 x:Class="MindMesh.UI.Views.WelcomePageView"
			 x:DataType="welcome:WelcomePageViewModel">

	<ScrollViewer>
		<StackPanel MaxWidth="820"
					Margin="40,64"
					Spacing="32"
					HorizontalAlignment="Center">

			<StackPanel Spacing="10">
				<ctl:Icon Key="logo"
						  Width="48"
						  Height="48"
						  StrokeThickness="1.5"
						  HorizontalAlignment="Left"
						  Foreground="{DynamicResource MM.Brush.Accent}" />
				<TextBlock Classes="h1" Text="{Binding Loc[Welcome_Title]}" />
				<TextBlock Classes="h3 secondary"
						   TextWrapping="Wrap"
						   Text="{Binding Loc[Welcome_Subtitle]}" />
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Classes="caption muted" Text="{Binding Loc[Welcome_Version]}" />
					<TextBlock Classes="caption muted" Text="{Binding Version}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
					<Button Classes="primary"
							Command="{Binding NewProjectCommand}"
							Content="{Binding Loc[Project_New]}" />
					<Button Command="{Binding OpenProjectsCommand}"
							Content="{Binding Loc[Project_OpenExisting]}" />
				</StackPanel>
			</StackPanel>

			<!-- Open the editor without a project -->
			<Button Classes="card"
					HorizontalAlignment="Left"
					Padding="16,12"
					Command="{Binding OpenEditorCommand}">
				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<ctl:Icon Key="workflows"
								  Width="20"
								  Height="20"
								  VerticalAlignment="Center"
								  Foreground="{DynamicResource MM.Brush.Accent}" />
						<TextBlock Classes="h3"
								   VerticalAlignment="Center"
								   Text="{Binding Loc[Welcome_OpenEditor]}" />
					</StackPanel>
					<TextBlock Classes="secondary"
							   MaxWidth="320"
							   TextWrapping="Wrap"
							   Text="{Binding Loc[Welcome_OpenEditorHint]}" />
				</StackPanel>
			</Button>

			<!-- Secondary places: small buttons at the bottom -->
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Classes="small"
						Command="{Binding OpenSettingsCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<ctl:Icon Key="settings" Width="16" Height="16" />
						<TextBlock VerticalAlignment="Center" Text="{Binding Loc[Welcome_OpenSettings]}" />
					</StackPanel>
				</Button>
				<Button Classes="small"
						Command="{Binding OpenAboutCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<ctl:Icon Key="info" Width="16" Height="16" />
						<TextBlock VerticalAlignment="Center" Text="{Binding Loc[Welcome_OpenAbout]}" />
					</StackPanel>
				</Button>
			</StackPanel>

			<!-- Projects: at the bottom of the screen, with search -->
			<views:ProjectGalleryView DataContext="{Binding Projects}" />
		</StackPanel>
	</ScrollViewer>

</UserControl>
