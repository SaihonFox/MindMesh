<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:shell="using:MindMesh.Presentation.Shell"
			 xmlns:editor="using:MindMesh.Presentation.Pages.Editor"
			 xmlns:ctl="using:MindMesh.UI.Controls"
			 x:Class="MindMesh.UI.Views.TopBarView"
			 x:DataType="shell:TopBarViewModel">

	<Border Classes="topbar">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,0" VerticalAlignment="Center">

			<!-- Logo -->
			<Button Grid.Column="0"
					Classes="logo"
					Command="{Binding GoHomeCommand}"
					ToolTip.Tip="{Binding Loc[TopBar_Home]}">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<ctl:Icon Key="logo"
							  Width="22"
							  Height="22"
							  Foreground="{DynamicResource MM.Brush.Accent}" />
					<TextBlock Text="MindMesh"
							   FontSize="15"
							   FontWeight="SemiBold"
							   VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<!-- Project / workflow / save status -->
			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="8"
						Margin="20,0,0,0"
						VerticalAlignment="Center"
						IsVisible="{Binding HasProject}">
				<Button Classes="crumb"
						Command="{Binding BeginRenameCommand}"
						IsVisible="{Binding !IsRenaming}"
						ToolTip.Tip="{Binding Loc[Project_RenameTip]}">
					<TextBlock FontWeight="SemiBold"
							   Text="{Binding ProjectDisplayName}"
							   VerticalAlignment="Center" />
				</Button>
				<TextBox x:Name="RenameBox"
						 Width="220"
						 MaxLength="120"
						 IsVisible="{Binding IsRenaming}"
						 Text="{Binding RenameText, Mode=TwoWay}"
						 VerticalAlignment="Center"
						 LostFocus="OnRenameLostFocus"
						 AttachedToVisualTree="OnRenameBoxAttached">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
						<KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
					</TextBox.KeyBindings>
				</TextBox>
				<StackPanel Orientation="Horizontal"
							Spacing="8"
							IsVisible="{Binding ShowWorkflow}">
					<TextBlock Classes="muted" Text="/" VerticalAlignment="Center" />
					<TextBlock Text="{Binding WorkflowDisplayName}"
							   VerticalAlignment="Center" />
				</StackPanel>
				<TextBlock Classes="caption muted"
						   Margin="8,0,0,0"
						   Text="{Binding SaveStatusText}"
						   VerticalAlignment="Center" />
			</StackPanel>

			<!-- Editor actions (only on the editor page) -->
			<StackPanel Grid.Column="2"
						Orientation="Horizontal"
						Spacing="2"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding IsEditorActive}">

				<Button Classes="icon"
						Command="{Binding Toolbar.Editor.UndoCommand}"
						ToolTip.Tip="{Binding Loc[Tip_Undo]}"
						ToolTip.ShowOnDisabled="True">
					<ctl:Icon Key="undo" Width="18" Height="18" />
				</Button>
				<Button Classes="icon"
						Command="{Binding Toolbar.Editor.RedoCommand}"
						ToolTip.Tip="{Binding Loc[Tip_Redo]}"
						ToolTip.ShowOnDisabled="True">
					<ctl:Icon Key="redo" Width="18" Height="18" />
				</Button>

				<Border Classes="separator-vertical" />

				<Button Classes="icon"
						IsEnabled="{Binding Toolbar.HasActiveWorkflow}"
						ToolTip.Tip="{Binding Loc[Tip_AutoLayout]}"
						ToolTip.ShowOnDisabled="True">
					<ctl:Icon Key="auto-layout" Width="18" Height="18" />
				</Button>
				<Button Classes="icon"
						IsEnabled="{Binding Toolbar.HasActiveWorkflow}"
						ToolTip.Tip="{Binding Loc[Tip_Validate]}"
						ToolTip.ShowOnDisabled="True">
					<ctl:Icon Key="validate" Width="18" Height="18" />
				</Button>

				<Border Classes="separator-vertical" />

				<Button Classes="icon"
						IsEnabled="{Binding Toolbar.HasActiveWorkflow}"
						ToolTip.Tip="{Binding Loc[Tip_Debug]}"
						ToolTip.ShowOnDisabled="True">
					<ctl:Icon Key="debug" Width="18" Height="18" />
				</Button>
				<Button Classes="primary"
						Margin="6,0,0,0"
						IsEnabled="{Binding Toolbar.HasActiveWorkflow}"
						ToolTip.Tip="{Binding Loc[Tip_Run]}"
						ToolTip.ShowOnDisabled="True">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<ctl:Icon Key="run" Width="14" Height="14" StrokeThickness="2" />
						<TextBlock Text="{Binding Loc[Toolbar_Run]}" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</StackPanel>

			<!-- Mode, panels, user menu -->
			<StackPanel Grid.Column="3"
						Orientation="Horizontal"
						Spacing="6"
						VerticalAlignment="Center">

				<StackPanel Orientation="Horizontal"
							Spacing="6"
							VerticalAlignment="Center"
							IsVisible="{Binding IsEditorActive}">

					<ComboBox MinWidth="140"
							  ItemsSource="{Binding Toolbar.Modes}"
							  SelectedItem="{Binding Toolbar.SelectedMode}"
							  ToolTip.Tip="{Binding Loc[Toolbar_Mode]}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="editor:EditorModeOptionViewModel">
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<ToggleButton Classes="icon"
								  Padding="10,6"
								  IsChecked="{Binding Toolbar.Layout.IsAssistantVisible}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<ctl:Icon Key="assistant" Width="16" Height="16" />
							<TextBlock Text="{Binding Loc[Toolbar_Assistant]}" VerticalAlignment="Center" />
						</StackPanel>
					</ToggleButton>

					<ToggleButton Classes="icon"
								  IsChecked="{Binding Toolbar.Layout.IsNodeLibraryVisible}"
								  ToolTip.Tip="{Binding Loc[Toolbar_ToggleLibrary]}">
						<ctl:Icon Key="panel-left" Width="18" Height="18" />
					</ToggleButton>
					<ToggleButton Classes="icon"
								  IsChecked="{Binding Toolbar.Layout.IsConsoleVisible}"
								  ToolTip.Tip="{Binding Loc[Toolbar_ToggleConsole]}">
						<ctl:Icon Key="panel-bottom" Width="18" Height="18" />
					</ToggleButton>
					<ToggleButton Classes="icon"
								  IsChecked="{Binding Toolbar.Layout.IsInspectorVisible}"
								  ToolTip.Tip="{Binding Loc[Toolbar_ToggleInspector]}">
						<ctl:Icon Key="panel-right" Width="18" Height="18" />
					</ToggleButton>

					<Border Classes="separator-vertical" />
				</StackPanel>

				<Menu Classes="user" VerticalAlignment="Center">
					<MenuItem Padding="8,6">
						<MenuItem.Header>
							<ctl:Icon Key="user" Width="18" Height="18" />
						</MenuItem.Header>
						<MenuItem Header="{Binding Loc[UserMenu_Settings]}"
								  Command="{Binding OpenSettingsCommand}" />
						<MenuItem Header="{Binding Loc[UserMenu_About]}"
								  Command="{Binding OpenAboutCommand}" />
					</MenuItem>
				</Menu>
			</StackPanel>
		</Grid>
	</Border>

</UserControl>
