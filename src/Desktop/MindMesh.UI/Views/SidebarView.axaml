<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:shell="using:MindMesh.Presentation.Shell"
			 xmlns:ctl="using:MindMesh.UI.Controls"
			 x:Class="MindMesh.UI.Views.SidebarView"
			 x:DataType="shell:SidebarViewModel">

	<UserControl.Resources>
		<DataTemplate x:Key="NavItemTemplate" x:DataType="shell:NavigationItemViewModel">
			<Button Classes="nav"
					Classes.selected="{Binding IsSelected}"
					Command="{Binding ActivateCommand}"
					ToolTip.Tip="{Binding Title}">
				<!-- the icon sits in a fixed square, so it never moves while the sidebar opens or closes -->
				<Grid ColumnDefinitions="40,*">
					<ctl:Icon Key="{Binding IconKey}" Width="18" Height="18" />
					<TextBlock Grid.Column="1"
							   Text="{Binding Title}"
							   TextWrapping="NoWrap"
							   VerticalAlignment="Center" />
				</Grid>
			</Button>
		</DataTemplate>
	</UserControl.Resources>

	<ctl:RoundedFrame Classes="sidebar" Width="{Binding Width}">
		<ctl:RoundedFrame.Transitions>
			<Transitions>
				<DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseInOut" />
			</Transitions>
		</ctl:RoundedFrame.Transitions>

		<DockPanel LastChildFill="True">
			<StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
				<ItemsControl ItemsSource="{Binding FooterItems}"
							  ItemTemplate="{StaticResource NavItemTemplate}" />
				<Button Classes="nav"
						Command="{Binding ToggleCompactCommand}"
						ToolTip.Tip="{Binding Loc[Sidebar_Toggle]}">
					<Grid ColumnDefinitions="40,*">
						<ctl:Icon Key="panel-left" Width="18" Height="18" />
						<TextBlock Grid.Column="1"
								   Text="{Binding ToggleTitle}"
								   TextWrapping="NoWrap"
								   VerticalAlignment="Center" />
					</Grid>
				</Button>
			</StackPanel>

			<ItemsControl Margin="0,6,0,0"
						  ItemsSource="{Binding Items}"
						  ItemTemplate="{StaticResource NavItemTemplate}" />
		</DockPanel>
	</ctl:RoundedFrame>

</UserControl>
