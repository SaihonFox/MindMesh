<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Theme independent design tokens: radii, font sizes, fixed sizes. -->

	<CornerRadius x:Key="MM.CornerRadius.Small">4</CornerRadius>
	<CornerRadius x:Key="MM.CornerRadius.Medium">6</CornerRadius>
	<CornerRadius x:Key="MM.CornerRadius.Large">10</CornerRadius>

	<x:Double x:Key="MM.FontSize.Caption">11</x:Double>
	<x:Double x:Key="MM.FontSize.Small">12</x:Double>
	<x:Double x:Key="MM.FontSize.Body">13</x:Double>
	<x:Double x:Key="MM.FontSize.Title">15</x:Double>
	<x:Double x:Key="MM.FontSize.Headline">22</x:Double>
	<x:Double x:Key="MM.FontSize.Display">30</x:Double>

	<x:Double x:Key="MM.Size.TopBarHeight">48</x:Double>
	<x:Double x:Key="MM.Size.PanelHeaderHeight">36</x:Double>

</ResourceDictionary>
