<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Theme independent design tokens: radii, font sizes, fixed sizes. -->

	<CornerRadius x:Key="MM.CornerRadius.Small">8</CornerRadius>
	<CornerRadius x:Key="MM.CornerRadius.Medium">10</CornerRadius>
	<CornerRadius x:Key="MM.CornerRadius.Large">16</CornerRadius>

	<!-- The Fluent theme reads these for every stock control and popup, so rounding them rounds the whole app. -->
	<CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
	<CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

	<x:Double x:Key="MM.FontSize.Caption">11</x:Double>
	<x:Double x:Key="MM.FontSize.Small">12</x:Double>
	<x:Double x:Key="MM.FontSize.Body">13</x:Double>
	<x:Double x:Key="MM.FontSize.Title">15</x:Double>
	<x:Double x:Key="MM.FontSize.Headline">22</x:Double>
	<x:Double x:Key="MM.FontSize.Display">30</x:Double>

	<x:Double x:Key="MM.Size.TopBarHeight">40</x:Double>
	<x:Double x:Key="MM.Size.PanelHeaderHeight">32</x:Double>

</ResourceDictionary>
