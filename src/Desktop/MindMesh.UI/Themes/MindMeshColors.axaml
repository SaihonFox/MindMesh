		<!-- Midnight: based on the dark theme -->
		<ResourceDictionary x:Key="Midnight">

			<!-- surfaces -->
			<Color x:Key="MM.Color.Background">#0A0E1A</Color>
			<Color x:Key="MM.Color.Panel">#111729</Color>
			<Color x:Key="MM.Color.PanelAlt">#0E1322</Color>
			<Color x:Key="MM.Color.Node">#172036</Color>
			<Color x:Key="MM.Color.NodeHeader">#1E2944</Color>
			<Color x:Key="MM.Color.Border">#26324F</Color>

			<!-- text -->
			<Color x:Key="MM.Color.TextPrimary">#E6ECFA</Color>
			<Color x:Key="MM.Color.TextSecondary">#8D9BBA</Color>
			<Color x:Key="MM.Color.TextMuted">#62708F</Color>

			<!-- accent -->
			<Color x:Key="MM.Color.Accent">#5B8CFF</Color>
			<Color x:Key="MM.Color.AccentHover">#7BA2FF</Color>
			<Color x:Key="MM.Color.OnAccent">#0A0E1A</Color>
			<Color x:Key="MM.Color.Success">#4CCB91</Color>
			<Color x:Key="MM.Color.Warning">#E6B85C</Color>
			<Color x:Key="MM.Color.Error">#F07178</Color>
			<Color x:Key="MM.Color.Info">#64A8F5</Color>

			<!-- overlays -->
			<Color x:Key="MM.Color.Hover">#14FFFFFF</Color>
			<Color x:Key="MM.Color.Pressed">#22FFFFFF</Color>
			<Color x:Key="MM.Color.AccentSubtle">#265B8CFF</Color>
			<Color x:Key="MM.Color.AccentSubtleHover">#335B8CFF</Color>
			<Color x:Key="MM.Color.AccentMuted">#445B8CFF</Color>

			<!-- grid -->
			<Color x:Key="MM.Color.GridMinor">#1A2238</Color>
			<Color x:Key="MM.Color.GridMajor">#26324F</Color>

