<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="Avalonia">
		<PackageVersion Include="Avalonia" Version="12.1.5" />
		<PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
		<PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
		<PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
		<PackageVersion Include="Avalonia.Skia" Version="12.1.5" />
		<!-- Code editor used for Code, Expression and JSON settings. -->
		<PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<!-- Transitive dependency of Avalonia.Desktop (Linux). Pinned above the vulnerable range of GHSA-xrw6-gwf8-vvr9 (< 0.92.0). -->
		<PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
	</ItemGroup>

	<ItemGroup Label="MVVM">
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup Label="Microsoft.Extensions">
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup Label="Logging">
		<PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup Label="Testing">
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>

</Project>
